# Google Cloud OAuth 2.0 Web Client ID
# Can also be entered dynamically in-app via the Settings modal
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Cloudflare Worker Push Notification Relay & Sync URL
VITE_NOTIFICATION_RELAY_URL=https://spread-spends-worker.your-subdomain.workers.dev

# Web Push VAPID Public Key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

